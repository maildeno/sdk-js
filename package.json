{
  "name": "maildeno",
  "version": "2.1.3",
  "description": "Official JavaScript/TypeScript SDK for the Maildeno template API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maildeno/sdk-js.git"
  },
  "homepage": "https://github.com/maildeno/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/maildeno/sdk-js/issues"
  },
  "keywords": [
    "maildeno",
    "email",
    "template",
    "render",
    "sdk",
    "api",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Maildeno",
    "url": "https://maildeno.com"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "@size-limit/file": "^12.1.0"
  },
  "size-limit": [
    {
      "name": "JS bundle (index.mjs)",
      "path": "dist/index.mjs",
      "limit": "20 KB"
    },
    {
      "name": "Wasm engine (engine.wasm)",
      "path": "dist/engine.wasm",
      "limit": "150 KB"
    }
  ],
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
